{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessel.invalid/schemas/tsp-v1.schema.json",
  "title": "TSP 1.0.0 — manifest.json",
  "description": "Manifest of a Tessel package. The manifest is the root of trust: it is not protected by a hash of its own. Unknown fields are tolerated so the format can evolve.",
  "type": "object",
  "required": ["format", "format_version", "created_at", "generator", "project", "authorization", "components", "integrity", "metadata_files", "reproducibility"],
  "properties": {
    "format": { "const": "TSP" },
    "format_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "created_at": { "type": "string", "format": "date-time" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "revision": { "type": "string" } }
    },
    "engine": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "editor_version": { "type": "string" },
        "editor_version_with_revision": { "type": "string" }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["status", "approved_operations"],
      "properties": {
        "status": { "type": "string", "description": "Declared, never verified by the offline CLI (e.g. unspecified, unverified)." },
        "evidence_ref": { "type": "string" },
        "approved_operations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "inventory_path", "inventory_sha256", "logical_inventory_sha256", "file_count", "total_bytes"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "inventory_path": { "type": "string" },
        "inventory_sha256": { "$ref": "#/$defs/sha256" },
        "logical_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "metadata_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "required": ["restoration"],
      "properties": {
        "environment": { "type": "string" },
        "restoration": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "enum": ["not_tested", "attempted", "succeeded", "failed"] } }
        }
      }
    },
    "policy_ref": { "type": "string", "const": "policy/policy.json" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "component": {
      "type": "object",
      "required": ["id", "kind", "redistribution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "path": { "type": "string", "description": "Present when the component is included in the package." },
        "version": { "type": "string" },
        "redistribution": { "enum": ["approved", "unreviewed", "not_permitted"] },
        "availability": { "type": "string" },
        "provenance_ref": { "type": "string" },
        "license_declared": { "type": "string" },
        "origin_path": { "type": "string" },
        "note": { "type": "string" },
        "external_ref": { "type": "string", "description": "Present when files of the component were omitted (see integrity/external.json)." }
      }
    }
  }
}
